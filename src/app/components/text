.skills {
  position: relative;
  min-height: 100vh;

  padding: 180px var(--page-padding) 120px;

  scroll-margin-top: 120px;

  background: #f8f6ee;
  border-top: 1px solid var(--color-border);
}

/* =========================
   Section Label
   ========================= */

.sectionLabel {
  display: flex;
  align-items: center;
  gap: var(--space-3);

  margin-bottom: var(--space-8);

  font-family: var(--font-inter), sans-serif;
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;

  color: var(--color-muted);
}

/* =========================
   Heading
   ========================= */

.headingArea {
  max-width: 1240px;
}

.heading {
  margin: 0;

  font-size: clamp(56px, 6vw, 88px);
  line-height: 0.95;
  letter-spacing: -0.055em;
}

.headingStrong {
  font-family: var(--font-inter), sans-serif;
  font-weight: 600;
  color: #29293b;
}

.headingSerif {
  font-family: var(--font-dm-serif), serif;
  font-weight: 400;
  font-style: italic;

  letter-spacing: -0.045em;

  color: #7c7a82;
}

.description {
  max-width: 560px;

  margin-top: var(--space-5);

  font-family: var(--font-inter), sans-serif;
  font-size: var(--text-sm);
  line-height: var(--leading-relaxed);

  color: var(--color-muted);
}

/* =========================
   Category Filters
   ========================= */

.filters {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 12px;

  margin-top: var(--space-8);
}

.filter {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 10px 15px;

  border: 1px solid #ded9cb;
  border-radius: var(--radius-pill);

  background: #f3ead2;

  color: #29293b;

  font-family: var(--font-inter), sans-serif;
  font-size: 12px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    color 180ms ease,
    transform 180ms ease,
    box-shadow 180ms ease;
}

.filter:hover,
.filter:focus-visible {
  background: var(--color-accent);
  border-color: var(--color-accent);

  color: var(--color-bg);

  transform: translateY(-2px);

  box-shadow:
    0 8px 18px rgba(23, 24, 39, 0.10);
}

.filterDot {
  width: 6px;
  height: 6px;

  flex: 0 0 6px;

  border-radius: 50%;

  background: currentColor;

  opacity: 0.5;
}

/* =========================
   Workspace
   ========================= */

.workspace {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    300px;

  gap: 56px;

  margin-top: 52px;
}

/* =========================
   Periodic Table Grid
   ========================= */

.grid {
  display: grid;

  grid-template-columns:
    repeat(8, minmax(82px, 1fr));

  grid-auto-rows: minmax(108px, auto);

  gap: 6px;

  align-self: start;
}

/* =========================
   Base Tile
   ========================= */

.tile {
  position: relative;

  grid-row: var(--grid-row);
  grid-column: var(--grid-column);

  display: flex;

  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;

  min-width: 0;
  min-height: 108px;

  padding: 12px;

  border: 1px solid rgba(23, 24, 39, 0.07);
  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      #e9e7df 0%,
      #e0dccf 100%
    );

  color: #454352;

  text-align: left;

  cursor: pointer;

  transition:
    transform 180ms ease,
    background 180ms ease,
    color 180ms ease,
    opacity 180ms ease,
    filter 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

/* =========================
   Category Highlight
   ========================= */

.tileHighlighted {
  background:
    linear-gradient(
      145deg,
      #302f58 0%,
      #25254a 100%
    );

  color: #f6f2e7;

  border-color:
    rgba(41, 41, 74, 0.12);

  box-shadow:
    0 10px 22px
    rgba(23, 24, 39, 0.12);
}

/* =========================
   Category Dim
   ========================= */

.tileDimmed {
  opacity: 0.22;

  filter: grayscale(1);

  box-shadow: none;
}

/* =========================
   Individual Tile Hover
   ========================= */

.tile:hover,
.tile:focus-visible {
  z-index: 5;

  transform: translateY(-4px);

  border-color:
    rgba(23, 24, 39, 0.20);

  box-shadow:
    0 12px 26px
    rgba(23, 24, 39, 0.14);

  outline: none;
}

/* =========================
   Tile Number
   ========================= */

.tileNumber {
  font-family: var(--font-inter), sans-serif;

  font-size: 9px;
  font-weight: 600;

  line-height: 1;

  color: currentColor;

  opacity: 0.52;
}

/* =========================
   Tile Symbol
   ========================= */

.tileSymbol {
  margin-top: auto;

  font-family: var(--font-inter), sans-serif;

  font-size: clamp(27px, 2.5vw, 40px);
  font-weight: 700;

  line-height: 0.95;

  letter-spacing: -0.055em;
}

/* =========================
   Tile Name
   ========================= */

.tileName {
  width: 100%;

  margin-top: 10px;

  font-family: var(--font-inter), sans-serif;

  font-size: 9px;
  font-weight: 500;

  line-height: 1.2;

  color: currentColor;

  opacity: 0.72;
}

/* =========================
   Preview
   ========================= */

.preview {
  position: sticky;
  top: 140px;

  min-height: 390px;

  padding-top: 4px;

  align-self: start;

  background: transparent;
}

.previewCategory {
  display: block;

  margin-bottom: 14px;

  font-family: var(--font-inter), sans-serif;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.10em;

  text-transform: uppercase;

  color: var(--color-muted);
}

/* =========================
   Large Standalone Logo
   ========================= */

.previewLogo {
  display: flex;

  align-items: center;
  justify-content: flex-start;

  width: 220px;
  height: 220px;

  margin-bottom: 14px;

  background: transparent;

  border: 0;
}

/*
  Simple Icons SVGs use currentColor.
  Mask keeps the original SVG shape and
  lets us apply the brand color ourselves.
*/

.previewLogoImage {
  display: block;

  width: 190px;
  height: 190px;

  background: var(--logo-color);

  -webkit-mask-image: var(--logo-image);
  mask-image: var(--logo-image);

  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;

  -webkit-mask-position: center;
  mask-position: center;

  -webkit-mask-size: contain;
  mask-size: contain;
}

/* =========================
   Missing Logo Fallback
   ========================= */

.previewLogoFallback {
  display: flex;

  align-items: center;
  justify-content: flex-start;

  width: 190px;
  height: 190px;

  font-family: var(--font-inter), sans-serif;

  font-size: 52px;
  font-weight: 700;

  letter-spacing: -0.05em;

  color: var(--color-accent);
}

/* =========================
   Preview Text
   ========================= */

.preview h3 {
  margin: 0;

  font-family: var(--font-dm-serif), serif;

  font-size: 34px;
  font-weight: 400;

  line-height: 0.95;

  letter-spacing: -0.025em;
}

.preview p {
  max-width: 260px;

  margin-top: 12px;

  font-family: var(--font-inter), sans-serif;

  font-size: 13px;
  line-height: 1.55;

  color: var(--color-muted);
}

/* =========================
   Empty Preview
   ========================= */

.previewEmpty {
  display: flex;

  flex-direction: column;
  justify-content: center;

  min-height: 330px;
}

.previewEmpty > span {
  font-family: var(--font-dm-serif), serif;

  font-size: 24px;

  color: var(--color-text);
}

.previewEmpty p {
  max-width: 240px;

  margin-top: 10px;
}

/* =========================
   Responsive
   ========================= */

@media (max-width: 1200px) {
  .workspace {
    grid-template-columns:
      minmax(0, 1fr)
      260px;

    gap: 36px;
  }

  .grid {
    grid-template-columns:
      repeat(8, minmax(70px, 1fr));
  }

  .tile {
    min-height: 100px;
  }

  .previewLogo {
    width: 190px;
    height: 190px;
  }

  .previewLogoImage {
    width: 165px;
    height: 165px;
  }
}

@media (max-width: 1050px) {
  .workspace {
    grid-template-columns: 1fr;
  }

  /*
    On smaller screens the intentional desktop
    periodic positions become a normal flow.
  */
  .grid {
    grid-template-columns:
      repeat(5, minmax(90px, 1fr));
  }

  .tile {
    grid-row: auto;
    grid-column: auto;

    min-height: 105px;
  }

  .preview {
    position: relative;
    top: auto;

    min-height: 280px;

    padding-top: 32px;
  }

  .previewLogo {
    width: 180px;
    height: 180px;
  }

  .previewLogoImage {
    width: 155px;
    height: 155px;
  }
}

@media (max-width: 767px) {
  .skills {
    padding-top: 110px;
    padding-bottom: 80px;
  }

  .heading {
    font-size: clamp(44px, 12vw, 64px);
  }

  .description {
    max-width: 100%;
  }

  .filters {
    gap: 8px;
  }

  .filter {
    padding: 9px 12px;

    font-size: 11px;
  }

  .workspace {
    gap: 36px;

    margin-top: 36px;
  }

  .grid {
    grid-template-columns:
      repeat(3, minmax(90px, 1fr));

    gap: 5px;
  }

  .tile {
    grid-row: auto;
    grid-column: auto;

    min-height: 108px;

    padding: 11px;
  }

  .tileSymbol {
    font-size: 27px;
  }

  .tileName {
    font-size: 8px;
  }

  .preview {
    padding-top: 0;
  }

  .previewLogo {
    width: 160px;
    height: 160px;
  }

  .previewLogoImage {
    width: 140px;
    height: 140px;
  }
}

@media (max-width: 480px) {
  .grid {
    grid-template-columns:
      repeat(2, minmax(100px, 1fr));
  }
}